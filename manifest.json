{
  "manifest_version": 3,
  "name": "LC Dev",
  "version": "1.0.0",
  "description": "Open Medusa Jira tickets and pull requests, and ask Currybot to review.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "LC Dev"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/actions.js", "src/palette.js"],
      "run_at": "document_idle"
    }
  ]
}
